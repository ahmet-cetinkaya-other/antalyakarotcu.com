---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import HeroStrip from "../components/ui/HeroStrip.astro";
import heroImg from "../assets/images/backgrounds/hero.jpg";

const title = "İletişim | Antalya Karotçu: 7/24 Beton Kesme & Delme Desteği";
const description =
    "Antalya Karotçu ile 7/24 endüstriyel beton kesme, delme ve yıkım hizmetleri için hemen iletişime geçin. Projeniz için ücretsiz ve hızlı teklif alın.";

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "İletişim - Antalya Karotcu",
    description: description,
    url: "https://antalyakarotcu.com/iletisim",
    mainEntity: {
        "@type": "LocalBusiness",
        name: "Antalya Karotcu",
        telephone: "+90 532 609 68 02",
        address: {
            "@type": "PostalAddress",
            streetAddress:
                "Yükseliş Mahallesi, 2124 Sokak, Sakin Apartmanı, No:34/A",
            addressLocality: "Kepez",
            addressRegion: "Antalya",
            addressCountry: "TR",
        },
    },
};
---

<BaseLayout
    title={title}
    description={description}
    ogImage={{ image: heroImg, alt: "Antalya Karotcu İletişim" }}
    structuredData={structuredData}
>
    <style>
        .map-container {
            /* Filter removed to show full color map per user request */
        }
    </style>

    <section
        class="relative h-[400px] w-full bg-surface-strong overflow-hidden border-b-4 border-border"
    >
        <div class="absolute inset-0 z-0">
            <iframe
                class="map-container opacity-60"
                frameborder="0"
                height="100%"
                marginheight="0"
                marginwidth="0"
                scrolling="no"
                src="https://maps.google.com/maps?q=Y%C3%BCkseli%C5%9F%20Mahallesi%202124%20Sokak%20Kepez%20Antalya&t=&z=15&ie=UTF8&iwloc=&output=embed"
                width="100%"
            >
            </iframe>
            <div
                class="absolute inset-0 bg-background-concrete/30 pointer-events-none mix-blend-multiply"
            >
            </div>
            <div
                class="absolute inset-0 z-10 industrial-grid pointer-events-none opacity-40"
            >
            </div>
        </div>
        <div
            class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none"
        >
            <div class="relative">
                <span
                    class="material-symbols-outlined text-primary text-6xl drop-shadow-[0_0_15px_rgba(255,103,0,0.8)] animate-bounce"
                    >location_on</span
                >
                <div
                    class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-8 h-2 bg-black/50 blur-sm rounded-full"
                >
                </div>
            </div>
        </div>
        <div
            class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-background-concrete to-transparent pt-20 pb-8 z-20"
        >
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <h1
                    class="text-6xl md:text-8xl font-display font-bold uppercase text-text tracking-tighter drop-shadow-lg"
                >
                    Merkez <span class="text-primary">İletişim</span>
                </h1>
            </div>
        </div>
        <HeroStrip />
    </section>

    <section
        class="flex-grow py-16 lg:py-24 relative overflow-hidden bg-background-concrete"
    >
        <div
            class="absolute right-0 top-0 h-full w-1/3 bg-black/10 skew-x-12 translate-x-32 pointer-events-none"
        >
        </div>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
                <div class="lg:col-span-5 flex flex-col gap-8">
                    <div>
                        <div
                            class="mb-2 inline-flex items-center gap-2 rounded border border-primary/30 bg-primary/10 px-3 py-1"
                        >
                            <span
                                class="material-symbols-outlined text-primary text-sm"
                                >engineering</span
                            >
                            <span
                                class="text-sm font-display font-bold uppercase tracking-widest text-primary"
                                >7/24 Destek</span
                            >
                        </div>
                        <h2
                            class="text-4xl font-display font-bold uppercase text-text mb-6"
                        >
                            Mühendislik Ekibiyle Bağlantı Kurun
                        </h2>
                        <p class="text-text-muted text-lg leading-relaxed mb-8">
                            Acil endüstriyel beton kesme, delme operasyonları
                            veya proje tahmini için teknik ekibimize doğrudan
                            ulaşın.
                        </p>
                    </div>
                    <div
                        class="group bg-surface border-[3px] border-border hover:border-primary transition-colors p-6 relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-16 h-16 bg-white/5 -mr-8 -mt-8 rotate-45 transition-transform group-hover:scale-150 group-hover:bg-primary/10"
                        >
                        </div>
                        <div class="flex items-start gap-5 relative z-10">
                            <div
                                class="bg-primary/10 p-3 border border-primary/20 group-hover:bg-primary group-hover:text-white text-primary transition-colors"
                            >
                                <span class="material-symbols-outlined text-3xl"
                                    >phone_in_talk</span
                                >
                            </div>
                            <div>
                                <h3
                                    class="text-xl font-display font-bold uppercase text-text-muted mb-1 group-hover:text-primary transition-colors"
                                >
                                    Doğrudan Hat
                                </h3>
                                <p
                                    class="text-2xl font-bold text-text tracking-wide font-display"
                                >
                                    +90 532 609 68 02
                                </p>
                                <p
                                    class="text-sm text-text-muted mt-1 uppercase tracking-wider"
                                >
                                    Acil Durumlar İçin 7/24 Açık
                                </p>
                            </div>
                        </div>
                    </div>

                    <div
                        class="group bg-surface border-[3px] border-border hover:border-primary transition-colors p-6 relative overflow-hidden"
                    >
                        <div
                            class="absolute top-0 right-0 w-16 h-16 bg-white/5 -mr-8 -mt-8 rotate-45 transition-transform group-hover:scale-150 group-hover:bg-primary/10"
                        >
                        </div>
                        <div class="flex items-start gap-5 relative z-10">
                            <div
                                class="bg-primary/10 p-3 border border-primary/20 group-hover:bg-primary group-hover:text-white text-primary transition-colors"
                            >
                                <span class="material-symbols-outlined text-3xl"
                                    >factory</span
                                >
                            </div>
                            <div>
                                <h3
                                    class="text-xl font-display font-bold uppercase text-text-muted mb-1 group-hover:text-primary transition-colors"
                                >
                                    Merkez Ofis
                                </h3>
                                <p
                                    class="text-lg font-bold text-text leading-tight font-display tracking-wide"
                                >
                                    Yükseliş Mahallesi<br />
                                    2124 Sokak. Sakin Apartmanı.<br />
                                    No:34/A - Kepez /Antalya
                                </p>
                            </div>
                        </div>
                    </div>
                    <div
                        class="mt-4 flex items-center gap-4 border-t border-border pt-6"
                    >
                        <div
                            class="h-12 w-12 flex items-center justify-center bg-white/5 rounded-full border border-border"
                        >
                            <span class="material-symbols-outlined text-primary"
                                >public</span
                            >
                        </div>
                        <div>
                            <h4
                                class="text-xl font-display font-bold uppercase text-text"
                            >
                                Ülke Çapında Hizmet
                            </h4>
                            <p class="text-sm text-text-muted">
                                Türkiye'nin 81 iline hizmet veriyoruz
                            </p>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-7">
                    <div
                        class="bg-surface-strong p-8 md:p-10 border-t-4 border-primary shadow-2xl relative"
                    >
                        <div
                            class="absolute top-4 left-4 w-2 h-2 bg-gray-600 rounded-full shadow-inner"
                        >
                        </div>
                        <div
                            class="absolute top-4 right-4 w-2 h-2 bg-gray-600 rounded-full shadow-inner"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 left-4 w-2 h-2 bg-gray-600 rounded-full shadow-inner"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 right-4 w-2 h-2 bg-gray-600 rounded-full shadow-inner"
                        >
                        </div>
                        <h2
                            class="text-4xl md:text-5xl font-display font-bold uppercase text-text mb-2"
                        >
                            Teklif Alın
                        </h2>
                        <p
                            class="text-text-muted mb-8 uppercase tracking-widest text-sm font-bold border-b border-gray-700 pb-4 inline-block"
                        >
                            Teknik Özellikler Gereklidir
                        </p>
                        <form
                            id="contact-form"
                            class="grid grid-cols-1 md:grid-cols-2 gap-6"
                        >
                            <div class="space-y-2">
                                <label
                                    class="block text-xl font-display font-bold uppercase text-text-muted"
                                    for="name">Ad Soyad</label
                                >
                                <input
                                    class="w-full bg-input-charcoal border-none text-text placeholder-gray-500 focus:ring-2 focus:ring-primary h-14 px-4 font-bold rounded-sm"
                                    id="name"
                                    placeholder="AD SOYAD GİRİNİZ"
                                    type="text"
                                />
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="block text-xl font-display font-bold uppercase text-text-muted"
                                    for="company">Firma Adı</label
                                >
                                <input
                                    class="w-full bg-input-charcoal border-none text-text placeholder-gray-500 focus:ring-2 focus:ring-primary h-14 px-4 font-bold rounded-sm"
                                    id="company"
                                    placeholder="FİRMA ADI GİRİNİZ"
                                    type="text"
                                />
                            </div>

                            <div class="space-y-2">
                                <label
                                    class="block text-xl font-display font-bold uppercase text-text-muted"
                                    for="phone">Telefon Numarası</label
                                >
                                <input
                                    class="w-full bg-input-charcoal border-none text-text placeholder-gray-500 focus:ring-2 focus:ring-primary h-14 px-4 font-bold rounded-sm"
                                    id="phone"
                                    placeholder="+90 XXX XXX XX XX"
                                    type="tel"
                                />
                            </div>
                            <div class="space-y-2 md:col-span-2">
                                <label
                                    class="block text-xl font-display font-bold uppercase text-text-muted"
                                    for="service">Talep Edilen Hizmet</label
                                >
                                <select
                                    class="w-full bg-input-charcoal border-none text-text focus:ring-2 focus:ring-primary h-14 px-4 font-bold rounded-sm uppercase"
                                    id="service"
                                >
                                    <option>Karot Delme (Elmaslı)</option>
                                    <option>Duvar Kesme (Derz)</option>
                                    <option>Tel Kesme</option>
                                    <option
                                        >Kimyasal Ankraj (Filiz Ekimi)</option
                                    >
                                    <option>Kontrollü Yıkım</option>
                                    <option>Diğer / Danışmanlık</option>
                                </select>
                            </div>
                            <div class="space-y-2 md:col-span-2">
                                <label
                                    class="block text-xl font-display font-bold uppercase text-text-muted"
                                    for="details">Proje Detayları</label
                                >
                                <textarea
                                    class="w-full bg-input-charcoal border-none text-text placeholder-gray-500 focus:ring-2 focus:ring-primary p-4 font-medium rounded-sm"
                                    id="details"
                                    placeholder="Derinlik, çap, beton tipi ve konum detaylarını belirtiniz..."
                                    rows="4"></textarea>
                            </div>
                            <div class="md:col-span-2 pt-4">
                                <Button
                                    variant="primary"
                                    class="w-full text-3xl"
                                    type="submit"
                                >
                                    Talebi Gönder<span
                                        class="material-symbols-outlined text-4xl ml-2"
                                        >send</span
                                    >
                                </Button>
                                <p
                                    class="text-center text-gray-500 text-xs mt-4 uppercase tracking-wider"
                                >
                                    Talebi gönderdiğinizde e-posta uygulamanıza
                                    yönlendirileceksiniz ve kendi e-postanızdan
                                    gönderebileceksiniz.
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const form = document.getElementById("contact-form");
    if (form) {
        form.addEventListener("submit", (e) => {
            e.preventDefault();

            const name = (document.getElementById("name") as HTMLInputElement)
                ?.value;
            const company = (
                document.getElementById("company") as HTMLInputElement
            )?.value;
            const phone = (document.getElementById("phone") as HTMLInputElement)
                ?.value;
            const service = (
                document.getElementById("service") as HTMLSelectElement
            )?.value;
            const details = (
                document.getElementById("details") as HTMLTextAreaElement
            )?.value;

            const subject = "Antalya Karotçu - Yeni Hizmet Talebi";
            const body = `Merhaba,\n\nAşağıdaki hizmet talebini iletiyorum:\n\n**Kişisel Bilgiler:**\nAd Soyad: ${name}\nFirma Adı: ${company}\n\nTelefon: ${phone}\n\n**Hizmet Detayları:**\nTalep Edilen Hizmet: ${service}\nProje Detayları:\n${details}\n\nTeşekkürler.`;

            const mailtoLink = `mailto:iletisim@antalyakarotcu.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

            window.location.href = mailtoLink;
        });
    }
</script>
