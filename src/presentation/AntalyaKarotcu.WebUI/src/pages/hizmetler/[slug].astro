---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} | Antalya Karotçu`}
  description={entry.data.description}
>
  <section class="bg-surface border-b border-border py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="mb-4 inline-flex items-center gap-2 rounded border border-primary/30 bg-primary/10 px-3 py-1"
      >
        <span class="material-symbols-outlined text-primary text-sm"
          >{entry.data.icon}</span
        >
        <span class="text-xs font-bold uppercase tracking-widest text-primary"
          >Hizmet Detayı</span
        >
      </div>
      <h1
        class="text-4xl font-black uppercase tracking-tighter text-text sm:text-6xl"
      >
        {entry.data.title}
      </h1>
    </div>
  </section>

  <main class="py-12 bg-bg">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-8">
          <div class="prose dark:prose-invert max-w-none">
            <Content />
          </div>
        </div>

        <aside class="lg:col-span-4 space-y-8">
          {
            entry.data.image && (
              <div class="rounded-sm overflow-hidden border border-border">
                <Image
                  src={entry.data.image}
                  alt={entry.data.title}
                  class="w-full h-auto grayscale hover:grayscale-0 transition-all duration-500"
                />
              </div>
            )
          }

          {
            entry.data.technicalSpecs && (
              <div class="bg-surface border border-border p-6 rounded-sm">
                <h3 class="text-lg font-black uppercase text-text mb-4 border-b border-border pb-2">
                  Teknik Özellikler
                </h3>
                <dl class="space-y-4">
                  {entry.data.technicalSpecs.map((spec) => (
                    <div>
                      <dt class="text-xs text-text-muted uppercase font-bold tracking-widest">
                        {spec.label}
                      </dt>
                      <dd class="text-text font-mono font-bold">
                        {spec.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )
          }

          <div class="bg-primary p-6 rounded-sm text-white">
            <h3 class="text-xl font-black uppercase mb-4">
              Bu hizmete mi ihtiyacınız var?
            </h3>
            <p class="mb-6 text-white/90">
              Ücretsiz saha keşfi ve teklif için teknik ekibimizle iletişime
              geçin.
            </p>
            <Button
              variant="outline"
              class="w-full bg-white text-primary border-white hover:bg-white/90"
            >
              Teklif Alın
            </Button>
          </div>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
