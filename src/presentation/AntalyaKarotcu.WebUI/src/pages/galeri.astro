---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryGrid from "../components/gallery/GalleryGrid.astro";
import GalleryItem from "../components/gallery/GalleryItem.astro";
import Lightbox from "../components/gallery/Lightbox.astro";
import Icon from "../components/ui/Icon.astro";
import HeroStrip from "../components/ui/HeroStrip.astro";
import { Image } from "astro:assets";
import mapBg from "../assets/images/backgrounds/gallery-map.png";

// Load all images and videos from the gallery folder
const galleryFiles = import.meta.glob<{ default: ImageMetadata | string }>(
  "/src/content/gallery/**/*.{jpeg,jpg,png,webp,mp4,webm,mov}",
  {
    eager: true,
  },
);

// Helper to format category slug to title
const categoryNames: Record<string, string> = {
  "beton-kesme": "Beton Kesme",
  "karot-delme": "Karot Delme",
  yikim: "Yıkım",
  ankraj: "Ankraj",
  diger: "Diğer",
};

const projects = Object.entries(galleryFiles).map(([path, mod]) => {
  const parts = path.split("/");
  // Expected path: /src/content/gallery/{category}/{filename}.ext
  // parts: ['', 'src', 'content', 'gallery', 'category', 'filename.ext']
  const categorySlug = parts[4];
  const filename = parts[5];
  const title = filename.split(".")[0].replace(/-/g, " ");

  const categoryName =
    categoryNames[categorySlug] ||
    categorySlug.charAt(0).toUpperCase() + categorySlug.slice(1);

  const isVideo = filename.match(/\.(mp4|webm|mov)$/i);

  // For videos, the default export is usually the URL string. For images, it might be an object (ImageMetadata) or string.
  // We keep the object for images to use with <Image /> component.
  const image = mod.default;

  return {
    id: path, // unique id from path
    data: {
      title: title.charAt(0).toUpperCase() + title.slice(1),
      category: categoryName,
      image,
      type: isVideo ? "video" : "image",
      stats: [],
    },
  };
});

const title = "Proje Galerisi | Antalya Karotçu: Beton Kesme ve Delme İşleri";
const description =
  "Antalya genelindeki beton kesme, delme ve yıkım projelerimizden örnekler. Mühendislik hassasiyetiyle tamamladığımız işlerimizi inceleyin.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Galeri - Antalya Karotcu",
  description: description,
  url: "https://antalyakarotcu.com/galeri",
};

// Dynamic categories based on found folders + 'All'
const foundCategories = [
  ...new Set(projects.map((p) => p.data.category)),
].sort();
const categories = [
  { name: "Tüm Projeler", active: true },
  ...foundCategories.map((name) => ({ name, active: false })),
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={{ image: mapBg, alt: "Antalya Karotcu Proje Haritası" }}
  structuredData={structuredData}
>
  <!-- Hero Section with Industrial Grid -->
  <section
    class="relative bg-surface-strong border-b border-border pt-32 pb-20 overflow-hidden"
  >
    <!-- Background Patterns -->
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-bg/80 via-transparent to-bg"
      >
      </div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl">
        <div
          class="inline-flex items-center gap-2 mb-6 text-primary border border-primary/20 bg-primary/5 px-3 py-1 rounded"
        >
          <Icon name="engineering" class="text-sm" />
          <span class="text-xs font-bold uppercase tracking-widest"
            >Portföy 2024</span
          >
        </div>

        <h1
          class="text-5xl md:text-7xl font-black uppercase text-text leading-[0.9] tracking-tight mb-6"
        >
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-500"
            >Mühendislik</span
          ><br />
          Hassasiyeti Galerisi
        </h1>

        <p class="text-xl text-text-muted max-w-2xl font-medium">
          Karmaşık beton işleme yeteneklerimizi gösteren, en zorlu ve teknik
          açıdan talepkar projelerimizin bir koleksiyonu.
        </p>
      </div>
    </div>
    <HeroStrip />
  </section>

  <!-- Gallery Grid Component -->
  <section class="min-h-screen bg-bg relative">
    <div class="container mx-auto px-4 py-8">
      <GalleryGrid projects={projects} categories={categories} />
    </div>
  </section>

  <!-- Map Section (Static Representation) -->
  <section
    class="py-20 bg-surface-strong border-t border-border relative overflow-hidden"
  >
    <!-- Decorative Background -->
    <div
      class="absolute right-0 top-0 w-1/2 h-full opacity-10 mix-blend-overlay pointer-events-none"
    >
      <Image
        src={mapBg}
        alt="Antalya Haritası"
        class="h-full w-full object-cover"
      />
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div
        class="flex flex-col md:flex-row items-center justify-between gap-12"
      >
        <div class="max-w-xl">
          <div
            class="mb-4 text-primary text-sm font-bold uppercase tracking-widest flex items-center gap-2"
          >
            <Icon name="location_on" />
            <span>Hizmet Bölgesi</span>
          </div>
          <h2 class="text-4xl font-black uppercase text-text mb-6">
            Akdeniz Bölgesi Genelinde Faaliyet
          </h2>
          <p class="text-text-muted mb-8 leading-relaxed">
            Antalya'nın kalbinden çevre ilçelere kadar, mobil filomuz göreve
            hazır. Zorlu arazilerde, yüksek katlı inşaatlarda ve sanayi
            bölgelerinde projeler yürütüyoruz.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div
              class="flex items-center gap-3 p-4 bg-white/5 border border-white/10"
            >
              <span class="text-2xl font-bold text-primary">07</span>
              <div class="flex flex-col">
                <span class="text-xs text-gray-500 uppercase"
                  >Birincil Bölge</span
                >
                <span class="text-sm font-bold text-text">Antalya Merkez</span>
              </div>
            </div>
            <div
              class="flex items-center gap-3 p-4 bg-white/5 border border-white/10"
            >
              <span class="text-2xl font-bold text-text">24</span>
              <div class="flex flex-col">
                <span class="text-xs text-gray-500 uppercase"
                  >Müdahale Süresi</span
                >
                <span class="text-sm font-bold text-text">Saat Maksimum</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Stylized Map Graphic / List -->
        <div class="w-full md:w-1/3">
          <div class="bg-bg border border-border p-6 relative">
            <div class="absolute -top-2 -right-2 w-4 h-4 bg-primary"></div>
            <h3
              class="text-lg font-bold text-text uppercase mb-4 border-b border-border pb-2"
            >
              Aktif Bölgeler
            </h3>
            <ul class="space-y-3">
              <li
                class="flex justify-between items-center text-sm group cursor-default"
              >
                <span
                  class="text-text-muted group-hover:text-text transition-colors"
                  >Muratpaşa</span
                >
                <span
                  class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.5)]"
                ></span>
              </li>
              <li
                class="flex justify-between items-center text-sm group cursor-default"
              >
                <span
                  class="text-text-muted group-hover:text-text transition-colors"
                  >Konyaaltı</span
                >
                <span
                  class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.5)]"
                ></span>
              </li>
              <li
                class="flex justify-between items-center text-sm group cursor-default"
              >
                <span
                  class="text-text-muted group-hover:text-text transition-colors"
                  >Kepez</span
                >
                <span
                  class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.5)]"
                ></span>
              </li>
              <li
                class="flex justify-between items-center text-sm group cursor-default"
              >
                <span
                  class="text-text-muted group-hover:text-text transition-colors"
                  >Alanya</span
                >
                <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
              </li>
              <li
                class="flex justify-between items-center text-sm group cursor-default"
              >
                <span
                  class="text-text-muted group-hover:text-text transition-colors"
                  >Kemer</span
                >
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"
                ></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
