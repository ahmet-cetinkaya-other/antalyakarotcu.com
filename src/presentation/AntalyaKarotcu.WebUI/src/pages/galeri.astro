---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const title = "Project Gallery | Antalya Karotcu";
const description = "Showcase of our engineering precision in concrete cutting, drilling, and demolition projects across Antalya.";

// Static categories for the filter bar
const categories = [
  { name: 'All Projects', active: true },
  { name: 'Concrete Cutting', active: false },
  { name: 'Core Drilling', active: false },
  { name: 'Demolition', active: false },
  { name: 'Anchoring', active: false },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section with Industrial Grid -->
  <section class="relative bg-surface-strong border-b border-border pt-32 pb-20 overflow-hidden">
    <!-- Background Patterns -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-bg/80 via-transparent to-bg"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 mb-6 text-primary border border-primary/20 bg-primary/5 px-3 py-1 rounded">
          <Icon name="engineering" class="text-sm" />
          <span class="text-xs font-bold uppercase tracking-widest">Portfolio 2024</span>
        </div>
        
        <h1 class="text-5xl md:text-7xl font-black uppercase text-text leading-[0.9] tracking-tight mb-6">
          Engineering <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-500">Precision</span><br />
          Showcase
        </h1>
        
        <p class="text-xl text-text-muted max-w-2xl font-medium">
          A collection of our most challenging and technically demanding projects, demonstrating our capability in complex concrete manipulation.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter Bar -->
  <section class="sticky top-0 z-40 bg-bg/95 backdrop-blur-md border-b border-white/5">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-2 py-4 overflow-x-auto no-scrollbar mask-gradient">
        <span class="text-xs font-bold uppercase text-gray-500 mr-4 shrink-0 hidden sm:block">Filter By:</span>
        {categories.map((cat) => (
          <button 
            class={`
              whitespace-nowrap px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all duration-300 border
              ${cat.active 
                ? 'bg-primary text-white border-primary shadow-[0_0_15px_rgba(255,102,0,0.3)]' 
                : 'bg-transparent text-text-muted border-border hover:border-primary/50 hover:text-text'}
            `}
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-16 bg-bg relative">
    <div class="container mx-auto px-4">
      {projects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              category={project.data.category}
              image={project.data.image}
              specs={project.data.stats || []}
              href={`/projects/${project.id}`}
            />
          ))}
        </div>
      ) : (
         <div class="text-center py-20 border border-dashed border-border rounded-lg bg-surface/50">
           <Icon name="construction" class="text-4xl text-text-muted mb-4 mx-auto" />
           <p class="text-text-muted font-mono uppercase">No projects found in collection</p>
         </div>
      )}
    </div>
  </section>

  <!-- Map Section (Static Representation) -->
  <section class="py-20 bg-surface-strong border-t border-border relative overflow-hidden">
     <!-- Decorative Background -->
     <div class="absolute right-0 top-0 w-1/2 h-full bg-[url('https://maps.googleapis.com/maps/api/staticmap?center=Antalya,Turkey&zoom=10&size=800x600&style=feature:all|element:all|saturation:-100|visibility:simplified&sensor=false')] opacity-10 bg-cover bg-center mix-blend-overlay pointer-events-none"></div>
     
     <div class="container mx-auto px-4 relative z-10">
       <div class="flex flex-col md:flex-row items-center justify-between gap-12">
         <div class="max-w-xl">
           <div class="mb-4 text-primary text-sm font-bold uppercase tracking-widest flex items-center gap-2">
             <Icon name="location_on" />
             <span>Service Area</span>
           </div>
           <h2 class="text-4xl font-black uppercase text-text mb-6">Operating Across The Mediterranean Region</h2>
           <p class="text-text-muted mb-8 leading-relaxed">
             From the heart of Antalya to the surrounding districts, our mobile fleet is ready to deploy. We handle projects in difficult terrains, high-rise constructions, and industrial zones.
           </p>
           <div class="grid grid-cols-2 gap-4">
             <div class="flex items-center gap-3 p-4 bg-white/5 border border-white/10">
               <span class="text-2xl font-bold text-primary">07</span>
               <div class="flex flex-col">
                 <span class="text-xs text-gray-500 uppercase">Primary Zone</span>
                 <span class="text-sm font-bold text-text">Antalya Center</span>
               </div>
             </div>
              <div class="flex items-center gap-3 p-4 bg-white/5 border border-white/10">
                <span class="text-2xl font-bold text-text">24</span>
                <div class="flex flex-col">
                 <span class="text-xs text-gray-500 uppercase">Response Time</span>
                 <span class="text-sm font-bold text-text">Hours Max</span>
               </div>
             </div>
           </div>
         </div>
         
         <!-- Stylized Map Graphic / List -->
         <div class="w-full md:w-1/3">
           <div class="bg-bg border border-border p-6 relative">
             <div class="absolute -top-2 -right-2 w-4 h-4 bg-primary"></div>
             <h3 class="text-lg font-bold text-text uppercase mb-4 border-b border-border pb-2">Active Zones</h3>
             <ul class="space-y-3">
               <li class="flex justify-between items-center text-sm group cursor-default">
                 <span class="text-text-muted group-hover:text-text transition-colors">Muratpaşa</span>
                 <span class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.5)]"></span>
               </li>
               <li class="flex justify-between items-center text-sm group cursor-default">
                 <span class="text-text-muted group-hover:text-text transition-colors">Konyaaltı</span>
                 <span class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.5)]"></span>
               </li>
               <li class="flex justify-between items-center text-sm group cursor-default">
                 <span class="text-text-muted group-hover:text-text transition-colors">Kepez</span>
                 <span class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_5px_rgba(34,197,94,0.5)]"></span>
               </li>
               <li class="flex justify-between items-center text-sm group cursor-default">
                 <span class="text-text-muted group-hover:text-text transition-colors">Alanya</span>
                 <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
               </li>
               <li class="flex justify-between items-center text-sm group cursor-default">
                 <span class="text-text-muted group-hover:text-text transition-colors">Kemer</span>
                 <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
               </li>
             </ul>
           </div>
         </div>
       </div>
     </div>
  </section>
</BaseLayout>
