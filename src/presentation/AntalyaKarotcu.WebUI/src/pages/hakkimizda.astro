---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import { Image } from "astro:assets";
import heroBg from "../assets/images/backgrounds/about-hero.jpg";
import historyImg from "../assets/images/about/about-history.jpg";
import valuesBg from "../assets/images/backgrounds/values-bg.jpg";
import mastersImg from "../assets/images/about/about-masters.jpg";

const title = "Hakkımızda - Antalya Karotçu";
const description =
    "Antalya Karotçu: 1995'ten bugüne, Antalya'nın yapısal gelişiminde emeği olan, beton kesme ve güçlendirme alanındaki çözüm ortağınız.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Hakkımızda - Antalya Karotcu",
  description: description,
  url: "https://antalyakarotcu.com/hakkimizda",
  mainEntity: {
    "@type": "LocalBusiness",
    name: "Antalya Karotcu",
    foundingDate: "1995",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Yükseliş Mahallesi, 2124 Sokak, Sakin Apartmanı, No:34/A",
      addressLocality: "Kepez",
      addressRegion: "Antalya",
      addressCountry: "TR",
    },
  },
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={{ image: heroBg, alt: "Antalya Karotcu Hakkımızda" }}
  structuredData={structuredData}
>
    <section
        class="relative h-[85vh] w-full overflow-hidden bg-surface-strong flex items-center"
    >
        <div class="absolute inset-0 z-0">
            <div
                class="absolute inset-0 bg-gradient-to-r from-bg via-bg/90 to-transparent z-10 dark:from-neutral-900 dark:via-neutral-900/90"
            >
            </div>
            <div class="absolute inset-0">
                <Image
                    src={heroBg}
                    alt="İnşaat halindeki devasa beton köprü yapısı"
                    class="h-full w-full object-cover opacity-70 mix-blend-overlay"
                ></Image>
            </div>
            <div class="absolute inset-0 opacity-20 z-10 industrial-grid"></div>
        </div>
        <div
            class="relative z-20 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8"
        >
            <div class="max-w-4xl">
                <div
                    class="mb-6 inline-flex items-center gap-2 border-l-4 border-primary pl-4"
                >
                    <span
                        class="text-sm font-bold uppercase tracking-[0.2em] text-primary"
                        >Kuruluş 1995</span
                    >
                </div>
                <h1
                    class="mb-8 text-6xl font-black uppercase leading-[0.85] tracking-tighter text-text sm:text-7xl md:text-9xl"
                >
                    Temelimiz<br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-500"
                        >Hassasiyet</span
                    >
                </h1>
                <p
                    class="max-w-xl text-lg font-medium leading-relaxed text-text-muted md:text-xl border-t border-border pt-6"
                >
                    Otuz yıla yaklaşan tecrübemizle, Antalya'da beton delme,
                    kesme ve yapısal güçlendirme alanında güvenilir çözümler
                    üretiyoruz.
                </p>
            </div>
        </div>
        <div
            class="absolute bottom-0 left-0 h-2 w-full bg-[repeating-linear-gradient(45deg,#ff6600,#ff6600_20px,#1a1a1a_20px,#1a1a1a_40px)] opacity-80"
        >
        </div>
    </section>

    <div class="border-y border-border bg-surface relative z-30">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 gap-12 md:grid-cols-4">
                <div class="flex flex-col gap-2">
                    <span class="text-6xl font-black text-text tracking-tighter"
                        >28<span class="text-primary text-4xl align-top">+</span
                        ></span
                    >
                    <span class="h-1 w-12 bg-primary"></span>
                    <span
                        class="text-sm font-bold uppercase tracking-widest text-text-muted mt-2"
                        >Yıllık Deneyim</span
                    >
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-6xl font-black text-text tracking-tighter"
                        >5k<span class="text-primary text-4xl align-top">+</span
                        ></span
                    >
                    <span class="h-1 w-12 bg-primary"></span>
                    <span
                        class="text-sm font-bold uppercase tracking-widest text-text-muted mt-2"
                        >Projeye İmza</span
                    >
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-6xl font-black text-text tracking-tighter"
                        >100<span class="text-primary text-4xl align-top"
                            >%</span
                        ></span
                    >
                    <span class="h-1 w-12 bg-primary"></span>
                    <span
                        class="text-sm font-bold uppercase tracking-widest text-text-muted mt-2"
                        >Müşteri Güveni</span
                    >
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-6xl font-black text-text tracking-tighter"
                        >19</span
                    >
                    <span class="h-1 w-12 bg-primary"></span>
                    <span
                        class="text-sm font-bold uppercase tracking-widest text-text-muted mt-2"
                        >Hizmet Noktası</span
                    >
                </div>
            </div>
        </div>
    </div>

    <section class="bg-bg py-24 relative overflow-hidden">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col md:flex-row gap-16">
                <div class="md:w-1/3 sticky top-24 self-start">
                    <h2
                        class="text-primary text-sm font-bold uppercase tracking-[0.2em] mb-4"
                    >
                        Tarihçemiz
                    </h2>
                    <h3
                        class="text-4xl md:text-5xl font-black uppercase text-text mb-6 leading-none"
                    >
                        Yerel Bir<br />Değer
                    </h3>
                    <p class="text-text-muted text-lg leading-relaxed mb-8">
                        Antalya'da küçük bir atölye olarak başladık, bugün
                        şehrimizin her köşesine hizmet veren güvenilir bir ekip
                        olduk.
                    </p>
                    <div
                        class="h-64 w-full rounded overflow-hidden relative border-2 border-white/5"
                    >
                        <Image
                            src={historyImg}
                            alt="Eski şantiye alanı"
                            class="object-cover w-full h-full opacity-60 transition-all duration-700"
                        ></Image>
                        <div
                            class="absolute inset-0 bg-primary/20 mix-blend-overlay"
                        >
                        </div>
                    </div>
                </div>
                <div
                    class="md:w-2/3 relative pl-8 md:pl-16 border-l border-border space-y-20"
                >
                    <div class="relative group">
                        <div
                            class="absolute -left-[41px] md:-left-[73px] top-2 h-5 w-5 rounded-full bg-surface-strong border-4 border-primary shadow-[0_0_15px_rgba(255,102,0,0.5)] group-hover:scale-125 transition-transform"
                        >
                        </div>
                        <span
                            class="text-7xl font-black text-white/5 absolute -top-12 -left-4 select-none z-0"
                            >1995</span
                        >
                        <div class="relative z-10">
                            <span
                                class="text-primary font-bold text-lg mb-2 block"
                                >Başlangıç</span
                            >
                            <h4
                                class="text-3xl font-bold text-text uppercase mb-4"
                            >
                                Antalya'da Kuruldu
                            </h4>
                            <p class="text-text-muted leading-relaxed">
                                Antalya'nın turizmle büyüyen yapı sektöründe,
                                profesyonel karot hizmeti eksikliğini fark
                                ettik. İki kişilik ekibimizle, işimizi temiz ve
                                söz verdiğimiz zamanda yaparak sektöre adım
                                attık.
                            </p>
                        </div>
                    </div>
                    <div class="relative group">
                        <div
                            class="absolute -left-[41px] md:-left-[73px] top-2 h-5 w-5 rounded-full bg-surface-strong border-4 border-gray-600 group-hover:border-primary transition-colors"
                        >
                        </div>
                        <span
                            class="text-7xl font-black text-white/5 absolute -top-12 -left-4 select-none z-0"
                            >2008</span
                        >
                        <div class="relative z-10">
                            <span
                                class="text-primary font-bold text-lg mb-2 block"
                                >Genişleme</span
                            >
                            <h4
                                class="text-3xl font-bold text-text uppercase mb-4"
                            >
                                Güçlü Ekipmanlarımız
                            </h4>
                            <p class="text-text-muted leading-relaxed">
                                Ekipman parkurumuzu modernize ederek, Antalya
                                bölgesindeki inşaat ve tadilat projelerinde her
                                türlü ihtiyaca cevap verebilecek kapasiteye
                                ulaştık.
                            </p>
                        </div>
                    </div>
                    <div class="relative group">
                        <div
                            class="absolute -left-[41px] md:-left-[73px] top-2 h-5 w-5 rounded-full bg-surface-strong border-4 border-gray-600 group-hover:border-primary transition-colors"
                        >
                        </div>
                        <span
                            class="text-7xl font-black text-white/5 absolute -top-12 -left-4 select-none z-0"
                            >2015</span
                        >
                        <div class="relative z-10">
                            <span
                                class="text-primary font-bold text-lg mb-2 block"
                                >Gelişim</span
                            >
                            <h4
                                class="text-3xl font-bold text-text uppercase mb-4"
                            >
                                Uzman Kadro
                            </h4>
                            <p class="text-text-muted leading-relaxed">
                                Güvenlik ve kalite standartlarımızı en üst
                                seviyeye taşıdık. Ekibimiz, karmaşık kimyasal
                                ankraj ve sismik güçlendirme projelerinde
                                uzmanlaşmış sertifikalı ustalardan oluşmaktadır.
                            </p>
                        </div>
                    </div>
                    <div class="relative group">
                        <div
                            class="absolute -left-[41px] md:-left-[73px] top-2 h-5 w-5 rounded-full bg-surface-strong border-4 border-gray-600 group-hover:border-primary transition-colors"
                        >
                        </div>
                        <span
                            class="text-7xl font-black text-white/5 absolute -top-12 -left-4 select-none z-0"
                            >2023</span
                        >
                        <div class="relative z-10">
                            <span
                                class="text-primary font-bold text-lg mb-2 block"
                                >Bugün</span
                            >
                            <h4
                                class="text-3xl font-bold text-text uppercase mb-4"
                            >
                                Antalya'nın Tercihi
                            </h4>
                            <p class="text-text-muted leading-relaxed">
                                5.000'den fazla başarılı proje ile Antalya ve
                                çevresindeki inşaat projelerinin güvenilir çözüm
                                ortağıyız. Ekipman parkurumuz, son teknoloji
                                elmas kesim aletleri ile sürekli
                                güncellenmektedir.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-surface-strong py-24 border-t border-white/5 relative">
        <div class="absolute right-0 top-0 h-full w-1/2">
            <Image
                src={valuesBg}
                alt="İnşaat detayları"
                class="h-full w-full object-cover opacity-5 mix-blend-luminosity"
            ></Image>
        </div>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16 max-w-2xl mx-auto">
                <h2
                    class="text-primary text-sm font-bold uppercase tracking-[0.2em] mb-4"
                >
                    Değerlerimiz
                </h2>
                <h3
                    class="text-4xl md:text-5xl font-black uppercase text-text mb-6"
                >
                    İşimizin Özü
                </h3>
                <p class="text-text-muted text-lg">
                    Sadece beton kesmiyoruz; komşularımız için güven inşa
                    ediyoruz. İşimize yaklaşımımız bu üç temel üzerine
                    kuruludur.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div
                    class="bg-bg border border-border p-10 hover:border-primary transition-colors group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
                    >
                        <span
                            class="material-symbols-outlined text-9xl text-text"
                            >health_and_safety</span
                        >
                    </div>
                    <div
                        class="mb-6 inline-flex items-center justify-center h-16 w-16 rounded bg-surface-strong border border-primary text-primary shadow-[0_0_20px_rgba(255,102,0,0.2)]"
                    >
                        <span class="material-symbols-outlined !text-4xl"
                            >health_and_safety</span
                        >
                    </div>
                    <h4 class="text-2xl font-bold text-text uppercase mb-4">
                        Önce Güvenlik
                    </h4>
                    <p class="text-text-muted leading-relaxed">
                        Riskli bir sektörde çalışıyoruz ve bunun şakası yok.
                        Çalışanlarımızın ve projenizin güvenliği için gerekli
                        tüm önlemleri almadan kontağı çalıştırmayız.
                    </p>
                </div>
                <div
                    class="bg-bg border border-border p-10 hover:border-primary transition-colors group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
                    >
                        <span
                            class="material-symbols-outlined text-9xl text-text"
                            >precision_manufacturing</span
                        >
                    </div>
                    <div
                        class="mb-6 inline-flex items-center justify-center h-16 w-16 rounded bg-surface-strong border border-primary text-primary shadow-[0_0_20px_rgba(255,102,0,0.2)]"
                    >
                        <span class="material-symbols-outlined !text-4xl"
                            >precision_manufacturing</span
                        >
                    </div>
                    <h4 class="text-2xl font-bold text-text uppercase mb-4">
                        Ustalık ve Hassasiyet
                    </h4>
                    <p class="text-text-muted leading-relaxed">
                        Yapısal bütünlük dikkat gerektirir. Her kesimin projeye
                        tam uyması için tecrübeli ustalarımız ve modern
                        ekipmanlarımızla milimetrik çalışıyoruz.
                    </p>
                </div>
                <div
                    class="bg-bg border border-border p-10 hover:border-primary transition-colors group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
                    >
                        <span
                            class="material-symbols-outlined text-9xl text-text"
                            >local_shipping</span
                        >
                    </div>
                    <div
                        class="mb-6 inline-flex items-center justify-center h-16 w-16 rounded bg-surface-strong border border-primary text-primary shadow-[0_0_20px_rgba(255,102,0,0.2)]"
                    >
                        <span class="material-symbols-outlined !text-4xl"
                            >verified_user</span
                        >
                    </div>
                    <h4 class="text-2xl font-bold text-text uppercase mb-4">
                        Yerel Esnaflık
                    </h4>
                    <p class="text-text-muted leading-relaxed">
                        Biz bu şehrin firmasıyız. Telefonumuz her zaman açık,
                        verdiğimiz söz senettir. İş bittikten sonra da yüz yüze
                        bakacak olmanın sorumluluğunu taşırız.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-bg py-20 border-t border-white/5">
        <div
            class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-12"
        >
            <div class="w-full md:w-1/2">
                <Image
                    src={mastersImg}
                    alt="Duvar kesme makinesi kullanan ekip"
                    class="rounded border-2 border-border transition-all duration-500 w-full shadow-2xl"
                ></Image>
            </div>
            <div class="w-full md:w-1/2">
                <h3 class="text-3xl font-black uppercase text-text mb-6">
                    İşinin Ehli Ustalar
                </h3>
                <p class="text-text-muted text-lg mb-8">
                    Operatörlerimiz sadece çalışan değil; işini severek yapan
                    zanaatkarlardır. Her ekip üyemiz, sahadaki tecrübesiyle size
                    en doğru çözümü sunmak için çalışır.
                </p>
                <div class="flex flex-wrap gap-4">
                    <div
                        class="bg-surface-strong px-4 py-2 rounded border border-border text-text-muted text-sm font-bold uppercase tracking-wide"
                    >
                        İş Güvenliği Sertifikalı
                    </div>
                    <div
                        class="bg-surface-strong px-4 py-2 rounded border border-border text-text-muted text-sm font-bold uppercase tracking-wide"
                    >
                        Hilti Eğitimli
                    </div>
                    <div
                        class="bg-surface-strong px-4 py-2 rounded border border-border text-text-muted text-sm font-bold uppercase tracking-wide"
                    >
                        İlk Yardım Sertifikalı
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-primary py-16 relative overflow-hidden">
        <div
            class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgMWgydjJIMUMxeiIgZmlsbD0iIzAwMCIgZmlsbC1vcGFjaXR5PSIwLjEiLz48L3N2Zz4=')] opacity-20"
        >
        </div>
        <div
            class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8"
        >
            <div>
                <h2
                    class="text-3xl md:text-4xl font-black uppercase text-white mb-2"
                >
                    Uzmanlarla Çalışın
                </h2>
                <p class="text-white/80 text-lg font-medium">
                    Yapısal ihtiyaçlarınız için tecrübeli ekibimizle görüşün.
                    Size en uygun ve ekonomik çözümü sunalım.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
                <Button variant="outline" class="px-8 py-4" href="/iletisim">
                    Teklif İste
                </Button>
            </div>
        </div>
    </section>
</BaseLayout>
