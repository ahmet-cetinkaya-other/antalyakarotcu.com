---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Button from "../components/ui/Button.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import HeroStrip from "../components/ui/HeroStrip.astro";
import Icon from "../components/ui/Icon.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroImg from "../assets/images/backgrounds/hero.jpg";
import placeholderImg from "../assets/images/placeholder/service-fallback.jpg";

const services = await getCollection("services");
const title = "Antalya Karotçu: Profesyonel Beton Kesme & Delme Hizmetleri";
const description =
  "Antalya'da güvenilir karot, beton delme ve kesme çözümleri. 1995'ten beri tecrübeli ekibimizle, uygun fiyat ve yüksek hassasiyetli hizmet sunuyoruz.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Antalya Karotcu",
  description: description,
  telephone: "+90 532 609 68 02",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Yükseliş Mahallesi, 2124 Sokak, Sakin Apartmanı, No:34/A",
    addressLocality: "Kepez",
    addressRegion: "Antalya",
    addressCountry: "TR",
  },
  url: "https://antalyakarotcu.com",
  image: "https://antalyakarotcu.com/assets/images/backgrounds/hero.jpg", // Fallback/Actual URL if predictable
  priceRange: "₺₺",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ],
      opens: "08:00",
      closes: "18:00",
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={{ image: heroImg, alt: "Antalya Karotcu Şantiye Çalışması" }}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative h-[85vh] w-full overflow-hidden bg-surface-strong">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-gradient-to-r from-bg via-bg/90 to-transparent z-10 dark:from-neutral-900 dark:via-neutral-900/90"
      >
      </div>
      <div class="absolute inset-0">
        <Image
          src={heroImg}
          alt="Ağır sanayi beton delme makinesinin yakın çekimi"
          class="h-full w-full object-cover opacity-60 mix-blend-overlay"
        />
      </div>
      <!-- Texture Overlay -->
      <div class="absolute inset-0 opacity-20 z-10 industrial-grid"></div>
    </div>

    <div
      class="relative z-20 mx-auto flex h-full max-w-7xl flex-col justify-center px-4 sm:px-6 lg:px-8"
    >
      <div class="max-w-3xl">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded border border-primary/30 bg-primary/10 px-3 py-1 backdrop-blur-sm"
        >
          <Icon name="verified" class="text-primary text-sm" />
          <span class="text-xs font-bold uppercase tracking-widest text-primary"
            >Antalya'nın Yerel Gücü</span
          >
        </div>
        <h1
          class="mb-6 text-5xl font-black uppercase leading-[0.9] tracking-tighter text-text sm:text-7xl md:text-8xl"
        >
          Hassas <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-400"
            >Beton</span
          ><br />
          Çözümleri
        </h1>
        <p
          class="mb-10 max-w-xl text-lg font-medium leading-relaxed text-text-muted md:text-xl"
        >
          1995 yılından beri Antalya'nın yapısal dönüşümünde rol alıyoruz. En
          zorlu betonları bile hassasiyetle şekillendiriyor, projenize değer
          katıyoruz.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button
            variant="primary"
            href="/iletisim"
            class="h-14 px-8 text-base shadow-[0_0_20px_rgba(255,102,0,0.4)]"
          >
            <Icon name="dataset" class="mr-2" />
            Teklif Al
          </Button>
          <Button variant="outline" href="/galeri" class="h-14 px-8 text-base">
            <Icon name="play_circle" class="mr-2" />
            Galerimize Göz At
          </Button>
        </div>
      </div>
    </div>
    <HeroStrip />
  </section>

  <!-- Stats Bar -->
  <div class="border-y border-border bg-surface-strong relative z-30">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        <div class="flex flex-col gap-1 border-l-4 border-primary pl-6">
          <span class="text-5xl font-black text-text tracking-tighter"
            >28<span class="text-primary">+</span></span
          >
          <span
            class="text-sm font-bold uppercase tracking-widest text-text-muted"
            >Yıllık Deneyim</span
          >
        </div>
        <div class="flex flex-col gap-1 border-l-4 border-border pl-6">
          <span class="text-5xl font-black text-text tracking-tighter"
            >5k<span class="text-primary">+</span></span
          >
          <span
            class="text-sm font-bold uppercase tracking-widest text-text-muted"
            >Başarılı Operasyon</span
          >
        </div>
        <div class="flex flex-col gap-1 border-l-4 border-border pl-6">
          <span class="text-5xl font-black text-text tracking-tighter"
            >100<span class="text-primary">%</span></span
          >
          <span
            class="text-sm font-bold uppercase tracking-widest text-text-muted"
            >Müşteri Memnuniyeti</span
          >
        </div>
        <div class="flex flex-col gap-1 border-l-4 border-border pl-6">
          <span class="text-5xl font-black text-text tracking-tighter"
            >7/24</span
          >
          <span
            class="text-sm font-bold uppercase tracking-widest text-text-muted"
            >Kesintisiz Destek</span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Services Section -->
  <section class="bg-bg py-24 relative overflow-hidden">
    <!-- Background element -->
    <div
      class="absolute right-0 top-0 h-full w-1/3 bg-surface-strong opacity-30 skew-x-12 translate-x-32 pointer-events-none"
    >
    </div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div
        class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end"
      >
        <SectionTitle title="Hizmetlerimiz" subtitle="Uzmanlık Alanlarımız" />
        <p class="max-w-md text-text-muted text-lg">
          Son teknoloji ekipmanlar kullanılarak yüksek hassasiyetli beton
          işlemleri.
        </p>
      </div>

      <!-- Masonry Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              image={service.data.image ?? placeholderImg}
              icon={service.data.icon}
              href={`/hizmetler/${service.id}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonial / Trust Section -->
  <section class="bg-surface-strong py-24 border-t border-border">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="mb-8 inline-flex items-center gap-2 text-primary">
            <Icon name="format_quote" />
            <span class="text-sm font-bold uppercase tracking-widest"
              >Müşteri Yorumları</span
            >
          </div>
          <h3
            class="text-3xl md:text-4xl font-black uppercase text-text mb-8 leading-tight"
          >
            "Antalya Karotçu, Modern Şehir Hastanesi genişletme projesinde
            olağanüstü hassasiyet sağladı. Güvenlik ve temizlik konusundaki
            titizlikleri etkileyici."
          </h3>
          <div class="flex items-center gap-4">
            <div
              class="h-14 w-14 rounded bg-surface flex items-center justify-center text-text-muted"
            >
              <Icon name="person" />
            </div>
            <div>
              <p class="text-text font-bold text-lg">Mehmet Yılmaz</p>
              <p class="text-primary text-sm uppercase tracking-wider">
                Proje Müdürü, Atlas İnşaat
              </p>
            </div>
          </div>
        </div>
        <div class="bg-surface p-8 rounded border border-border relative">
          <!-- Decorative Corner Marks -->
          <div
            class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-primary"
          >
          </div>
          <div
            class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-primary"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-primary"
          >
          </div>
          <div
            class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-primary"
          >
          </div>

          <h4
            class="text-text text-lg font-bold uppercase mb-6 text-center border-b border-border pb-4"
          >
            Birlikte Başardıklarımız
          </h4>
          <div class="grid grid-cols-2 gap-8 opacity-60">
            <div
              class="h-12 bg-surface-strong rounded flex items-center justify-center text-text-muted font-bold uppercase"
            >
              Atlas İnşaat
            </div>
            <div
              class="h-12 bg-surface-strong rounded flex items-center justify-center text-text-muted font-bold uppercase"
            >
              Zirve Yapı
            </div>
            <div
              class="h-12 bg-surface-strong rounded flex items-center justify-center text-text-muted font-bold uppercase"
            >
              Nova Mimarlık
            </div>
            <div
              class="h-12 bg-surface-strong rounded flex items-center justify-center text-text-muted font-bold uppercase"
            >
              Gökdelen Holding
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-primary py-16 relative overflow-hidden">
    <!-- Abstract background pattern -->
    <div
      class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgMWgydjJIMUMxeiIgZmlsbD0iIzAwMCIgZmlsbC1vcGFjaXR5PSIwLjEiLz48L3N2Zz4=')] opacity-20"
    >
    </div>
    <div
      class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8"
    >
      <div>
        <h2 class="text-3xl md:text-4xl font-black uppercase text-white mb-2">
          Projeye başlamaya hazır mısınız?
        </h2>
        <p class="text-white/80 text-lg font-medium">
          Projeniz için 24 saat içinde detaylı teklif alın.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
        <Button variant="outline" class="px-8 py-4" href="/iletisim">
          Teklif İste
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
