---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Button from '../components/ui/Button.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Icon from '../components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const title = "Antalya Karotcu - Industrial Precision";
const description = "Professional concrete drilling, cutting, and construction services.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative h-[85vh] w-full overflow-hidden bg-surface-darker">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-background-dark via-background-dark/90 to-transparent z-10"></div>
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-60 mix-blend-overlay" data-alt="Close up of heavy industrial concrete drilling machinery sparks flying dark atmosphere"></div>
      <!-- Texture Overlay -->
      <div class="absolute inset-0 opacity-20 z-10 industrial-grid"></div>
    </div>
    
    <div class="relative z-20 mx-auto flex h-full max-w-7xl flex-col justify-center px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded border border-primary/30 bg-primary/10 px-3 py-1 backdrop-blur-sm">
          <Icon name="verified" class="text-primary text-sm" />
          <span class="text-xs font-bold uppercase tracking-widest text-primary">ISO 9001:2015 Certified</span>
        </div>
        <h1 class="mb-6 text-5xl font-black uppercase leading-[0.9] tracking-tighter text-white sm:text-7xl md:text-8xl">
          Precision <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-orange-400">Concrete</span><br/>
          Solutions
        </h1>
        <p class="mb-10 max-w-xl text-lg font-medium leading-relaxed text-gray-300 md:text-xl">
          Since 1995, we've delivered heavy-duty drilling, demolition, and cutting services for Antalya's most complex engineering challenges.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button variant="primary" href="/fleet" class="h-14 px-8 text-base shadow-[0_0_20px_rgba(255,102,0,0.4)]">
            <Icon name="dataset" class="mr-2" />
            Explore Our Fleet
          </Button>
          <Button variant="outline" class="h-14 px-8 text-base">
            <Icon name="play_circle" class="mr-2" />
            Watch Showreel
          </Button>
        </div>
      </div>
    </div>
    <!-- Bottom decorative bar -->
    <div class="absolute bottom-0 left-0 h-2 w-full bg-[repeating-linear-gradient(45deg,#ff6600,#ff6600_20px,#1a1a1a_20px,#1a1a1a_40px)] opacity-80"></div>
  </section>

  <!-- Stats Bar -->
  <div class="border-y border-white/10 bg-surface-dark relative z-30">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        <div class="flex flex-col gap-1 border-l-4 border-primary pl-6">
          <span class="text-5xl font-black text-white tracking-tighter">28<span class="text-primary">+</span></span>
          <span class="text-sm font-bold uppercase tracking-widest text-gray-400">Years Experience</span>
        </div>
        <div class="flex flex-col gap-1 border-l-4 border-gray-700 pl-6">
          <span class="text-5xl font-black text-white tracking-tighter">1k<span class="text-primary">+</span></span>
          <span class="text-sm font-bold uppercase tracking-widest text-gray-400">Projects Done</span>
        </div>
        <div class="flex flex-col gap-1 border-l-4 border-gray-700 pl-6">
          <span class="text-5xl font-black text-white tracking-tighter">0</span>
          <span class="text-sm font-bold uppercase tracking-widest text-gray-400">Safety Incidents</span>
        </div>
        <div class="flex flex-col gap-1 border-l-4 border-gray-700 pl-6">
          <span class="text-5xl font-black text-white tracking-tighter">24/7</span>
          <span class="text-sm font-bold uppercase tracking-widest text-gray-400">Support Team</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Services Section -->
  <section class="bg-background-dark py-24 relative overflow-hidden">
    <!-- Background element -->
    <div class="absolute right-0 top-0 h-full w-1/3 bg-surface-dark opacity-30 skew-x-12 translate-x-32 pointer-events-none"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <SectionTitle title="Industrial Services" subtitle="Our Expertise" />
        <p class="max-w-md text-gray-400 text-lg">
          High-precision concrete manipulation using state-of-the-art diamond cutting technology.
        </p>
      </div>

      <!-- Masonry Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.description}
            image={service.data.image}
            icon={service.data.icon}
            href={`/services/${service.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial / Trust Section -->
  <section class="bg-surface-darker py-24 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="mb-8 inline-flex items-center gap-2 text-primary">
            <Icon name="format_quote" />
            <span class="text-sm font-bold uppercase tracking-widest">Client Feedback</span>
          </div>
          <h3 class="text-3xl md:text-4xl font-black uppercase text-white mb-8 leading-tight">
            "Antalya Karotcu delivered exceptional precision on the Akdeniz University expansion. Their safety protocols are unmatched."
          </h3>
          <div class="flex items-center gap-4">
            <div class="h-14 w-14 rounded bg-gray-700 flex items-center justify-center text-gray-400">
              <Icon name="person" />
            </div>
            <div>
              <p class="text-white font-bold text-lg">Mehmet Yılmaz</p>
              <p class="text-primary text-sm uppercase tracking-wider">Site Manager, Yapi Construction</p>
            </div>
          </div>
        </div>
        <div class="bg-background-dark p-8 rounded border border-white/5 relative">
          <!-- Decorative Corner Marks -->
          <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-primary"></div>
          <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-primary"></div>
          <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-primary"></div>
          <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-primary"></div>
          
          <h4 class="text-white text-lg font-bold uppercase mb-6 text-center border-b border-white/10 pb-4">Trusted By Industry Leaders</h4>
          <div class="grid grid-cols-2 gap-8 opacity-60">
            <div class="h-12 bg-white/10 rounded flex items-center justify-center text-white/50 font-bold uppercase">Limak</div>
            <div class="h-12 bg-white/10 rounded flex items-center justify-center text-white/50 font-bold uppercase">Rixos</div>
            <div class="h-12 bg-white/10 rounded flex items-center justify-center text-white/50 font-bold uppercase">Tav</div>
            <div class="h-12 bg-white/10 rounded flex items-center justify-center text-white/50 font-bold uppercase">Ic Holding</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-primary py-16 relative overflow-hidden">
    <!-- Abstract background pattern -->
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgMWgydjJIMUMxeiIgZmlsbD0iIzAwMCIgZmlsbC1vcGFjaXR5PSIwLjEiLz48L3N2Zz4=')] opacity-20"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-black uppercase text-white mb-2">Ready to break ground?</h2>
        <p class="text-white/80 text-lg font-medium">Get a detailed quote for your project within 24 hours.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
        <Button variant="primary" class="bg-surface-darker hover:bg-black text-white w-full sm:w-auto text-center shadow-lg hover:-translate-y-1 border-none">
          Request Quote
        </Button>
        <Button variant="ghost" class="bg-white/20 text-white hover:bg-white/30 backdrop-blur-sm w-full sm:w-auto text-center">
          Call Now
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
