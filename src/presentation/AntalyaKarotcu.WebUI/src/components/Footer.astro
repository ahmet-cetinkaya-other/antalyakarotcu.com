---
const today = new Date();
---

<footer class="bg-surface-strong border-t border-border pt-20 pb-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16"
        >
            <!-- Brand -->
            <div class="flex flex-col gap-6">
                <div class="flex items-center gap-3">
                    <img
                        src="/favicon.svg"
                        alt="Antalya Karotçu Logosu"
                        class="h-10 w-auto"
                    />
                    <div class="flex flex-col">
                        <span
                            class="text-xl font-black uppercase tracking-widest leading-none text-text"
                            >Antalya</span
                        >
                        <span
                            class="text-sm font-bold uppercase tracking-widest leading-none text-primary"
                            >Karotçu</span
                        >
                    </div>
                </div>
                <p class="text-text-muted text-sm leading-relaxed">
                    Antalya'da birinci sınıf beton kesme ve delme hizmetleri.
                    Sertifikalı hassasiyet, endüstriyel güç.
                </p>
                <div class="flex gap-4">
                    <a
                        class="text-text-muted hover:text-primary transition-colors"
                        href="#"
                        ><span class="material-symbols-outlined">public</span
                        ></a
                    >
                    <a
                        class="text-text-muted hover:text-primary transition-colors"
                        href="mailto:iletisim@antalyakarotcu.com"
                        ><span class="material-symbols-outlined"
                            >alternate_email</span
                        ></a
                    >
                </div>
            </div>
            <!-- Links -->
            <div>
                <h4
                    class="text-text font-bold uppercase tracking-wider mb-6 border-b border-border pb-2 inline-block"
                >
                    Kurumsal
                </h4>
                <ul class="space-y-4">
                    <li>
                        <a
                            class="text-text-muted hover:text-primary transition-colors text-sm"
                            href="/hakkimizda">Hakkımızda</a
                        >
                    </li>
                    <li>
                        <a
                            class="text-text-muted hover:text-primary transition-colors text-sm"
                            href="/galeri">Projeler</a
                        >
                    </li>
                </ul>
            </div>
            <!-- Services -->
            <div>
                <h4
                    class="text-text font-bold uppercase tracking-wider mb-6 border-b border-border pb-2 inline-block"
                >
                    Hizmetler
                </h4>
                <ul class="space-y-4">
                    <li>
                        <a
                            class="text-text-muted hover:text-primary transition-colors text-sm"
                            href="/hizmetler/karot-delme">Karot Delme</a
                        >
                    </li>
                    <li>
                        <a
                            class="text-text-muted hover:text-primary transition-colors text-sm"
                            href="/hizmetler/beton-kesme">Duvar Kesme</a
                        >
                    </li>
                    <li>
                        <a
                            class="text-text-muted hover:text-primary transition-colors text-sm"
                            href="/hizmetler/beton-kesme">Tel Kesme</a
                        >
                    </li>
                    <li>
                        <a
                            class="text-text-muted hover:text-primary transition-colors text-sm"
                            href="/hizmetler/beton-kirma">Yıkım</a
                        >
                    </li>
                </ul>
            </div>
            <!-- Contact -->
            <div>
                <h4
                    class="text-text font-bold uppercase tracking-wider mb-6 border-b border-border pb-2 inline-block"
                >
                    İletişim
                </h4>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3 text-text-muted text-sm">
                        <span
                            class="material-symbols-outlined text-primary text-lg mt-0.5"
                            >location_on</span
                        >
                        <span
                            >Yükseliş Mahallesi<br />
                            2124 Sokak. Sakin Apartmanı.<br />
                            No:34/A - Kepez /Antalya</span
                        >
                    </li>
                    <li class="flex items-center gap-3 text-text-muted text-sm">
                        <span
                            class="material-symbols-outlined text-primary text-lg"
                            >call</span
                        >
                        <a
                            href="tel:+905326096802"
                            class="hover:text-primary transition-colors"
                            >+90 532 609 68 02</a
                        >
                    </li>
                    <li class="flex items-center gap-3 text-text-muted text-sm">
                        <span
                            class="material-symbols-outlined text-primary text-lg"
                            >mail</span
                        >
                        <a
                            href="mailto:iletisim@antalyakarotcu.com"
                            class="hover:text-primary transition-colors"
                            >iletisim@antalyakarotcu.com</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <div class="flex items-center gap-4">
                <p class="text-text-muted text-xs">
                    © {today.getFullYear()} Antalya Karotçu. Tüm hakları saklıdır.
                </p>
                <a
                    href="https://ahmetcetinkaya.me"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs text-text-muted underline decoration-text-muted/50 underline-offset-2 transition duration-300 hover:text-text hover:decoration-text/80"
                >
                    <img
                        src="https://ahmetcetinkaya.me/favicon.svg"
                        alt="Ahmet Çetinkaya"
                        class="size-3"
                        onerror="this.style.display='none'"
                    />
                    Ahmet Çetinkaya tarafından hazırlandı.
                </a>
            </div>
        </div>
    </div>
</footer>
