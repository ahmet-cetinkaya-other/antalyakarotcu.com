---
const today = new Date();
---

<footer class="bg-[#111] border-t border-white/10 pt-20 pb-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            <!-- Brand -->
            <div class="flex flex-col gap-6">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center bg-primary rounded text-white">
                        <span class="material-symbols-outlined">construction</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xl font-black uppercase tracking-widest leading-none text-white">Antalya</span>
                        <span class="text-sm font-bold uppercase tracking-widest leading-none text-primary">Karotcu</span>
                    </div>
                </div>
                <p class="text-gray-500 text-sm leading-relaxed">
                    Premier concrete cutting and drilling services in Antalya. Certified precision, industrial strength.
                </p>
                <div class="flex gap-4">
                    <a class="text-gray-400 hover:text-primary transition-colors" href="#"><span class="material-symbols-outlined">public</span></a>
                    <a class="text-gray-400 hover:text-primary transition-colors" href="#"><span class="material-symbols-outlined">alternate_email</span></a>
                </div>
            </div>
            <!-- Links -->
            <div>
                <h4 class="text-white font-bold uppercase tracking-wider mb-6 border-b border-white/10 pb-2 inline-block">Company</h4>
                <ul class="space-y-4">
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">About Us</a></li>
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Our Fleet</a></li>
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Projects</a></li>
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Careers</a></li>
                </ul>
            </div>
            <!-- Services -->
            <div>
                <h4 class="text-white font-bold uppercase tracking-wider mb-6 border-b border-white/10 pb-2 inline-block">Services</h4>
                <ul class="space-y-4">
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Core Drilling</a></li>
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Wall Sawing</a></li>
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Wire Sawing</a></li>
                    <li><a class="text-gray-400 hover:text-primary transition-colors text-sm" href="#">Demolition</a></li>
                </ul>
            </div>
            <!-- Contact -->
            <div>
                <h4 class="text-white font-bold uppercase tracking-wider mb-6 border-b border-white/10 pb-2 inline-block">Contact</h4>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3 text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-primary text-lg mt-0.5">location_on</span>
                        <span>Organize Sanayi Bölgesi<br/>1. Cadde No:12<br/>Antalya, Turkey</span>
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-primary text-lg">call</span>
                        <span>+90 555 123 4567</span>
                    </li>
                    <li class="flex items-center gap-3 text-gray-400 text-sm">
                        <span class="material-symbols-outlined text-primary text-lg">mail</span>
                        <span>info@antalyakarotcu.com</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-gray-600 text-xs">© {today.getFullYear()} Antalya Karotcu. All rights reserved.</p>
            <div class="flex gap-6">
                <a class="text-gray-600 hover:text-gray-400 text-xs uppercase" href="#">Privacy Policy</a>
                <a class="text-gray-600 hover:text-gray-400 text-xs uppercase" href="#">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
