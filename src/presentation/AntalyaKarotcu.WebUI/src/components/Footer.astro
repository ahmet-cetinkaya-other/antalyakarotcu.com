---
const today = new Date();
---

<footer class="bg-surface-strong border-t border-border pt-20 pb-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            <!-- Brand -->
            <div class="flex flex-col gap-6">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center bg-primary rounded text-white">
                        <span class="material-symbols-outlined">construction</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xl font-black uppercase tracking-widest leading-none text-text">Antalya</span>
                        <span class="text-sm font-bold uppercase tracking-widest leading-none text-primary">Karotcu</span>
                    </div>
                </div>
                <p class="text-text-muted text-sm leading-relaxed">
                    Antalya'da birinci sınıf beton kesme ve delme hizmetleri. Sertifikalı hassasiyet, endüstriyel güç.
                </p>
                <div class="flex gap-4">
                    <a class="text-text-muted hover:text-primary transition-colors" href="#"><span class="material-symbols-outlined">public</span></a>
                    <a class="text-text-muted hover:text-primary transition-colors" href="#"><span class="material-symbols-outlined">alternate_email</span></a>
                </div>
            </div>
            <!-- Links -->
            <div>
                <h4 class="text-text font-bold uppercase tracking-wider mb-6 border-b border-border pb-2 inline-block">Kurumsal</h4>
                <ul class="space-y-4">
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Hakkımızda</a></li>
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Makine Parkuru</a></li>
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Projeler</a></li>
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Kariyer</a></li>
                </ul>
            </div>
            <!-- Services -->
            <div>
                <h4 class="text-text font-bold uppercase tracking-wider mb-6 border-b border-border pb-2 inline-block">Hizmetler</h4>
                <ul class="space-y-4">
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Karot Delme</a></li>
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Duvar Kesme</a></li>
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Tel Kesme</a></li>
                    <li><a class="text-text-muted hover:text-primary transition-colors text-sm" href="#">Yıkım</a></li>
                </ul>
            </div>
            <!-- Contact -->
            <div>
                <h4 class="text-text font-bold uppercase tracking-wider mb-6 border-b border-border pb-2 inline-block">İletişim</h4>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3 text-text-muted text-sm">
                        <span class="material-symbols-outlined text-primary text-lg mt-0.5">location_on</span>
                        <span>Organize Sanayi Bölgesi<br/>1. Cadde No:12<br/>Antalya, Turkey</span>
                    </li>
                    <li class="flex items-center gap-3 text-text-muted text-sm">
                        <span class="material-symbols-outlined text-primary text-lg">call</span>
                        <span>+90 532 609 68 02</span>
                    </li>
                    <li class="flex items-center gap-3 text-text-muted text-sm">
                        <span class="material-symbols-outlined text-primary text-lg">mail</span>
                        <span>info@antalyakarotcu.com</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="border-t border-border pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-text-muted text-xs">© {today.getFullYear()} Antalya Karotcu. Tüm hakları saklıdır.</p>
            <div class="flex gap-6">
                <a class="text-text-muted hover:text-text-muted/80 text-xs uppercase" href="#">Gizlilik Politikası</a>
                <a class="text-text-muted hover:text-text-muted/80 text-xs uppercase" href="#">Kullanım Şartları</a>
            </div>
        </div>
    </div>
</footer>
