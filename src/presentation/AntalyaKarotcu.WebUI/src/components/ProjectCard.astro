---
interface Spec {
  label: string;
  value: string;
  isPrimary?: boolean;
}

interface Props {
  title: string;
  category: string;
  image: string;
  specs: Spec[];
  href?: string;
}

const { title, category, image, specs, href = "#" } = Astro.props;
---

<article
  class="break-inside-avoid relative group bg-surface border border-border hover:border-primary transition-colors duration-300"
>
  <!-- Corner Decorations -->
  <div
    class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-primary z-20"
  >
  </div>
  <div
    class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-primary z-20"
  >
  </div>

  <a href={href} class="relative overflow-hidden aspect-[4/3] block">
    <img
      alt={title}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 grayscale group-hover:grayscale-0"
      src={image}
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 to-transparent opacity-80"
    >
    </div>
    <div class="absolute bottom-4 left-4">
      <div
        class="bg-primary text-white text-[10px] font-bold uppercase px-2 py-1 mb-2 inline-block"
      >
        {category}
      </div>
      <h3
        class="text-xl font-bold text-white uppercase leading-tight hover:text-primary transition-colors"
        set:html={title.replace(/\n/g, "<br/>")}
      />
    </div>
  </a>
  <div class="p-6 bg-surface border-t border-border blueprint-grid-small">
    <div class="grid grid-cols-2 gap-y-4 gap-x-2">
      {
        specs.map((spec) => (
          <div class="flex flex-col">
            <span class="text-[10px] font-mono text-text-muted uppercase">
              {spec.label}
            </span>
            <span
              class={`text-sm font-bold uppercase ${spec.isPrimary ? "text-primary" : "text-text"}`}
            >
              {spec.value}
            </span>
          </div>
        ))
      }
    </div>
    <div class="mt-4 flex justify-end">
      <a
        href={href}
        class="text-primary hover:text-white hover:bg-primary px-3 py-1 rounded-sm text-xs font-bold uppercase tracking-widest flex items-center gap-1 group-hover:gap-2 transition-all"
      >
        Projeyi İncele <span class="material-symbols-outlined text-sm"
          >arrow_right_alt</span
        >
      </a>
    </div>
  </div>
</article>

<style>
  .blueprint-grid-small {
    background-size: 10px 10px;
    background-image:
      linear-gradient(to right, rgba(255, 102, 0, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 102, 0, 0.05) 1px, transparent 1px);
  }
</style>
