---
interface Props {
  title: string;
  subtitle?: string;
  class?: string;
  align?: 'left' | 'center' | 'right';
}

const { title, subtitle, class: className, align = 'left' } = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};
---

<div class={`flex flex-col gap-2 ${alignClasses[align]} ${className || ''}`}>
  {subtitle && (
    <span class="text-primary text-sm font-bold uppercase tracking-[0.2em]">
      {subtitle}
    </span>
  )}
   <h2 class="text-3xl md:text-4xl font-bold font-display text-text leading-tight">
      {title}
    </h2>
</div>
