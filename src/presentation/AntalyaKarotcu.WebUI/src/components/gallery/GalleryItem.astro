---
import Icon from "../ui/Icon.astro";

interface Props {
    project: any; // We'll type this properly if possible, or use the collection type
}

const { project } = Astro.props;
const { title, category, image, stats, type = "image" } = project.data;

// Prepare data for lightbox
const projectData = JSON.stringify({
    title,
    category,
    image,
    stats,
    type,
    id: project.id,
});
---

<div
    class="gallery-item group relative break-inside-avoid overflow-hidden rounded-sm border border-border bg-surface cursor-pointer"
    data-project={projectData}
    data-category={category}
>
    <!-- Image Container -->
    <div class="aspect-[4/3] overflow-hidden relative">
        {
            type === "video" ? (
                <video
                    src={image}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    muted
                    playsinline
                    loop
                    onmouseover="this.play()"
                    onmouseout="this.pause()"
                />
            ) : (
                <img
                    src={image}
                    alt={title}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                />
            )
        }

        <!-- Overlay Gradient -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
        </div>

        <!-- Icon Overlay -->
        <div
            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 scale-90 group-hover:scale-100 delay-75"
        >
            <div
                class="bg-primary/90 rounded-full w-12 h-12 flex items-center justify-center text-white shadow-lg backdrop-blur-sm"
            >
                <Icon
                    name={type === "video" ? "play_arrow" : "zoom_in"}
                    class="text-2xl"
                />
            </div>
        </div>
    </div>

    <!-- Content Overlay (Bottom) -->
    <div
        class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
    >
        <div class="flex flex-col items-start gap-1">
            <span
                class="inline-block bg-primary px-2 py-0.5 text-[10px] font-bold uppercase text-white tracking-wider"
            >
                {category}
            </span>
        </div>
    </div>
</div>
